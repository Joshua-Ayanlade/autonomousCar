<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--ROS2 CONTROL HARDWARE INTERFACE-->
    <ros2_control name="MobileBaseHardwareInterface" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="left_rear_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="right_rear_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="left_front_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="right_front_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

    </ros2_control>


    <!--Make the front wheels frictionless-->
    <gazebo reference="left_front_link">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
    </gazebo>
    <gazebo reference="right_front_link">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
    </gazebo>

    <!--GAZEBO CONTROLLER-->
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find robot_sim)/config/robot_sim.yaml</parameters>
        </plugin>


        <!--commented out because the ionic world file already selected the rendering enging-->
        
        <!--GAZEBO SENSOR RENDERING ENGINE-->
        <!-- <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin> -->
    </gazebo>


</robot>